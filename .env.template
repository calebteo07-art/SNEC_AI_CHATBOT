# EyeQ environment variables
# Copy this file to .env and fill in the values.

# Gemini API
GEMINI_API_KEY=

# Mock mode — set to "true" to skip real AI calls during development
MOCK_MODE=false

# Google Sheets OAuth (generated by running infrastructure_bootstrap.py)
GOOGLE_SPREADSHEET_ID=

# Gmail SMTP (for supervisor weekly reports)
# Use a Gmail App Password (not your main password):
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Supabase — vector database for knowledge base RAG
# Get from: supabase.com > project > Settings > API
# Use the SERVICE ROLE key (not the anon key) — needed for bulk inserts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-64-char-hex-string
JWT_EXPIRE_HOURS=8
