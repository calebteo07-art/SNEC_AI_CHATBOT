# EyeBot environment variables — copy to .env and fill in.
# In PRODUCTION the boot guard (tools/shared/config.py) refuses to start unless
# JWT_SECRET, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and a non-wildcard
# ALLOWED_ORIGINS are all set. See docs/SECURITY.md.

# ── Core ───────────────────────────────────────────────────────────────
# "development" | "production". Drives the fail-closed guard, cookie Secure
# flag, and Redis-backed rate limiting.
ENVIRONMENT=development

# Gemini API. Omit to run in MOCK_MODE (no real AI calls).
GEMINI_API_KEY=
# Force mock AI even with a key present (useful for local UI work / tests).
MOCK_MODE=false

# ── Auth ───────────────────────────────────────────────────────────────
# 64-hex-char signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-64-char-hex-string
# Hard cap on token lifetime (hours). The cookie itself is session-scoped
# (expires on browser close); this is the absolute maximum.
JWT_EXPIRE_HOURS=720
# Bootstrap admin — see the super-admin bootstrap steps in docs/SECURITY.md.
SUPER_ADMIN_EMAIL=your-admin@example.com

# ── CORS / network ─────────────────────────────────────────────────────
# Comma-separated allowed origins. REQUIRED in production (must NOT be "*").
# e.g. https://eyebot.yourschool.edu
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Largest accepted request body, bytes (default 2000000 = 2 MB).
MAX_REQUEST_BYTES=2000000

# ── Database (Supabase) ────────────────────────────────────────────────
# supabase.com > project > Settings > API. Use the SERVICE ROLE key (bulk RAG
# inserts need it), never the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Redis (Celery + rate limiting) ─────────────────────────────────────
# Local dev: redis://localhost:6379/0   Docker: redis://redis:6379/0
# REQUIRED when WEB_CONCURRENCY > 1 so rate-limit counters are shared across
# workers. Falls back to in-memory (per-worker) if unset.
REDIS_URL=redis://localhost:6379/0
# Override the rate-limit store explicitly (defaults to REDIS_URL in prod,
# in-memory in dev/test). e.g. memory:// to force in-memory.
# RATELIMIT_STORAGE_URI=

# ── Scaling / runtime ──────────────────────────────────────────────────
# uvicorn worker count (prod). 2+ needs ~1GB RAM and REDIS_URL set.
WEB_CONCURRENCY=1
# Bound on concurrent blocking calls (Gemini/bcrypt/SMTP) off the event loop.
THREAD_POOL_TOKENS=64
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Observability (optional) ───────────────────────────────────────────
# Set to enable Sentry error tracking; dormant (no-op) when unset.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Email (Gmail API) ──────────────────────────────────────────────────
# Render BLOCKS outbound SMTP, and a gmail.com From address can't be domain-
# authenticated by anyone but Google — so email sends through the Gmail API
# (HTTPS, Google DKIM-signs it). Mint the refresh token once with
# scripts/gmail_oauth_setup.py; see docs/superpowers/specs for setup.
EMAIL_FROM=            # the authorized account, e.g. snec.tne.edu@gmail.com
GMAIL_CLIENT_ID=       # Google Cloud → Credentials → OAuth client (Desktop app)
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=   # printed by scripts/gmail_oauth_setup.py

# ── Google integration (optional) ──────────────────────────────────────
GOOGLE_SPREADSHEET_ID=
