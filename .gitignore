# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# Environment variables
.env
.env.local
.env.*.local

# Node / Next.js
node_modules/
.next/
# Auto-generated by `next dev`/`next build`; regenerated every build (Next's own
# recommended .gitignore excludes it) — untracked to stop the perpetual phantom diff.
next-env.d.ts
npm-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.suo
*.user

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# API keys / secrets
secrets.json
config/secrets.*

# Google OAuth
credentials.json
token.json

# Temporary processing files (ignore contents, keep the directory)
.tmp/*
!.tmp/.gitkeep

# Claude Code / superpowers
# Ignore all of .claude/ EXCEPT the portable, team-shareable pieces so the
# friction-guardrail commands + hook survive an account switch (audit 2026-07-04).
.claude/*
!.claude/commands/
!.claude/hooks/
!.claude/settings.json
.superpowers/
.pytest_cache/

# Playwright MCP debug output
.playwright-mcp/

# TypeScript incremental build state
*.tsbuildinfo

# AURORA visual-sweep screenshots (regenerated, never committed)
frontend/*.png

# Loose scratch/screenshot images at repo root (real assets live in
# frontend/public/). Keeps the repo lean for fast clones.
/*.jpeg
/*.jpg
/*.png
# Session / scratch artifacts.
/.session-handoff.md
/.session-handoff-auto.md
/.awwwards_state.md
/.tmpuvicorn.log
