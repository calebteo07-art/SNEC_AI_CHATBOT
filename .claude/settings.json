{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bash_guard.py"],
            "timeout": 10,
            "statusMessage": "Checking for PowerShell cmdlets in Bash"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session_snapshot.py"],
            "timeout": 15,
            "statusMessage": "Writing auto session snapshot before compaction"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session_worktree.py"],
            "timeout": 10,
            "statusMessage": "Checking session worktree isolation"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  }
}
